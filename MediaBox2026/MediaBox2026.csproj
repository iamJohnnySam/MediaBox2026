<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Sdk.Web defaults Server GC on: one heap per core, sized for a box that has itself to spare.
      Atom is 4 cores / 3.6 GB running six .NET apps plus Jellyfin, Postgres and Samba. Workstation
      GC roughly halved Tower's idle heap (iamJohnnySam/Tower@599b382) at no latency cost here.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\tower_telegram.proto" GrpcServices="Client" />
    <Protobuf Include="Protos\mediabox_control.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.81.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!--
      Direct reference purely to lift the transitive SQLitePCLRaw off 2.1.11, which carries
      GHSA-2m69-gcr7-jv3q. Microsoft.Data.Sqlite still pins 2.1.11 even at 10.0.10, so bumping it
      alone does not clear the advisory. Held at 2.1.12 rather than 3.0.x: same major/minor as what
      Microsoft.Data.Sqlite expects, so no ABI surprise in the provider it loads at runtime.
      Remove when Microsoft.Data.Sqlite ships against a patched version by itself.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
